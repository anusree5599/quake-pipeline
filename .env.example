# Copy this file to .env and fill in your own values. .env is git-ignored.

# --- Gemini (used by the ADK agents) ---
# Free key: https://aistudio.google.com/apikey
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GOOGLE_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash

# --- Cloud storage ---
# STORAGE_BACKEND is one of: gcs, s3, local
#   gcs   -> Google Cloud Storage (auth via `gcloud auth application-default login`
#            or GOOGLE_APPLICATION_CREDENTIALS pointing at a service-account key)
#   s3    -> AWS S3 (auth via `aws configure`, AWS_PROFILE, or AWS_* env vars)
#   local -> writes to ./output/bucket (offline testing only)
STORAGE_BACKEND=gcs
GCS_BUCKET=your-gcs-bucket-name
S3_BUCKET=your-s3-bucket-name
AWS_REGION=us-east-1
